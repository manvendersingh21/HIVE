{"$schema":"http://json-schema.org/draft-07/schema#","definitions":{"EvidenceKind":{"description":"What kind of attestation an evidence object carries.","oneOf":[{"description":"A transcript of commands executed.","enum":["command_transcript"],"type":"string"},{"description":"An excerpt from a retained log.","enum":["log_excerpt"],"type":"string"},{"description":"Output of a test or check run.","enum":["test_output"],"type":"string"},{"description":"A cryptographic signature over the subject.","enum":["signature"],"type":"string"},{"additionalProperties":false,"description":"Anything else; the string says what, honestly unlabeled by the registry.","properties":{"other":{"type":"string"}},"required":["other"],"type":"object"}]},"EvidenceSubject":{"description":"What the evidence is about.","oneOf":[{"additionalProperties":false,"description":"An artifact id (§9.1).","properties":{"artifact":{"type":"string"}},"required":["artifact"],"type":"object"},{"additionalProperties":false,"description":"A free-form claim under the contract.","properties":{"claim":{"type":"string"}},"required":["claim"],"type":"object"}]}},"description":"One attestation (§9.2).","properties":{"digest":{"description":"SHA-256 of the evidence content, 64 lowercase hex.","type":"string"},"evidence_id":{"description":"`e-` + ≥12 lowercase hex.","type":"string"},"kind":{"$ref":"#/definitions/EvidenceKind"},"produced_by":{"description":"The agent that produced it.","type":"string"},"statement":{"description":"One honest sentence about what this evidence shows.","type":"string"},"subject":{"$ref":"#/definitions/EvidenceSubject"}},"required":["digest","evidence_id","kind","produced_by","statement","subject"],"title":"Evidence","type":"object"}
